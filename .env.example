# Get your Fieldwork API key (easiest path for owners):
#   Fieldwork app → Settings → Users & Routes → open your user → Integration → API Key
#   https://app.fieldworkhq.com/settings/users
#
# Help article: https://intercom.help/fieldwork/en/articles/2406552-fieldwork-apis
#
# NEVER commit the real key. Copy this file to .env and fill it in locally:
#   cp .env.example .env

FIELDWORK_API_KEY=

# Optional overrides
# FIELDWORK_BASE_URL=https://api3.fieldworkhq.com
# FIELDWORK_AUTH_SCHEME=api-key   # api-key (default) | query | token | bearer
# FIELDWORK_TIMEOUT_SECONDS=30

# Transport: stdio (default for Cursor/Claude Desktop) | streamable-http | sse
# FIELDWORK_MCP_TRANSPORT=stdio
# FIELDWORK_MCP_HOST=127.0.0.1
# FIELDWORK_MCP_PORT=8000

# Hosted HTTP (/connect + /mcp). Required in any shared deploy.
# FIELDWORK_MCP_HOSTED=1
# FIELDWORK_MCP_ALLOW_ENV_FALLBACK=0
# FIELDWORK_VAULT_SECRET=replace-with-a-long-random-string
# FIELDWORK_PUBLIC_BASE_URL=https://mcp.example.com
# FIELDWORK_VAULT_DB=/data/vault.sqlite3
# FIELDWORK_LANDING_DIR=/app/landing